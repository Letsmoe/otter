    "./testing": "./src/testing.ts",
    "./client": "./src/client.ts",
    "./generated": "./src/generated/index.ts"
  },
  "devDependencies": {
    "@genql/cli": "^6.3.4"
  },
  "dependencies": {
    "@genql/runtime": "^2.10.0",
    "node-html-parser": "^6.1.13"
