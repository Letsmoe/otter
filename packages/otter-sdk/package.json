{
  "name": "@letsmoe/otter-sdk",
  "version": "0.1.0",
  "private": false,
  "author": {
    "name": "Letsmoe",
    "url": "https://letsmoe.com"
  },
  "description": "SDK for writing Otter plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letsmoe/otter.git",
    "directory": "packages/otter-sdk"
  },
